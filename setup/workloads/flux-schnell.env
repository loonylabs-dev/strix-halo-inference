# --- registry -------------------------------------------------------------
# Read by setup/lib/models.sh (workloads_all) and setup/lib/budget.py
# (workload_plan). Started only through bench/sideserver.py --workload.
WORKLOAD_TITLE=FLUX.1-schnell text-to-image via stable-diffusion.cpp (Vulkan) · Apache 2.0
WORKLOAD_KIND=image
WORKLOAD_MODE=batch
# Why this model beside sdxl: the licence. FLUX.1-schnell is Apache 2.0 —
# the cleanest commercial terms in the current t2i field (FLUX.1-dev is
# non-commercial; SDXL is OpenRAIL++). A 4-step distillate, so the per-image
# cost is expected BELOW sdxl's 30 steps despite the larger model — that
# expectation is exactly what the first bench is for.
#
# Components per docs/flux.md of stable-diffusion.cpp: diffusion GGUF
# (city96, Q8_0 — the reference quant in sd.cpp's own table), T5-XXL text
# encoder as GGUF Q8_0 (city96), CLIP-L from comfyanonymous. All fetched
# 01.09.2026. The VAE (ae.safetensors) could NOT come from
# black-forest-labs/FLUX.1-schnell — that repo is gated and resolve returns
# 401 even though the tree API lists the file — so it came from the ungated
# mirror second-state/FLUX.1-schnell-GGUF the same day (335,304,388 bytes).
#
# --cfg-scale 1.0 and --steps 4: the schnell defaults from sd.cpp's docs.
# --seed 42 fixed: two runs of this profile are the same experiment.
WORKLOAD_CMD=@HOME@/stable-diffusion.cpp/build-vulkan-6b3edaaf3/bin/sd-cli \
  --diffusion-model @MODELS@/image/flux1-schnell-Q8_0.gguf \
  --vae @MODELS@/image/flux-ae.safetensors \
  --clip_l @MODELS@/image/clip_l.safetensors \
  --t5xxl @MODELS@/image/t5-v1_1-xxl-encoder-Q8_0.gguf \
  -H 1024 -W 1024 --steps 4 --cfg-scale 1.0 --sampling-method euler \
  --seed 42 -v
WORKLOAD_PROMPT=a lighthouse on a rocky coast at sunset, detailed oil painting, dramatic clouds
WORKLOAD_FILES=@MODELS@/image/flux1-schnell-Q8_0.gguf @MODELS@/image/flux-ae.safetensors @MODELS@/image/clip_l.safetensors @MODELS@/image/t5-v1_1-xxl-encoder-Q8_0.gguf
# WORKLOAD_SOURCE — where the weights come from, machine-readable
# (URLs, space-separated); fetched 01.09.2026. The prose history
# stays in the comments above; this line is for tooling and for
# the next machine.
WORKLOAD_SOURCE=https://huggingface.co/city96/FLUX.1-schnell-gguf/resolve/main/flux1-schnell-Q8_0.gguf https://huggingface.co/city96/t5-v1_1-xxl-encoder-gguf/resolve/main/t5-v1_1-xxl-encoder-Q8_0.gguf https://huggingface.co/comfyanonymous/flux_text_encoders/resolve/main/clip_l.safetensors https://huggingface.co/second-state/FLUX.1-schnell-GGUF/resolve/main/ae.safetensors
# WORKLOAD_SMOKE_SHA256 — the DETERMINISM PIN: the exact output hash a
# 1-rep bench at this profile's settings on the pinned build must
# reproduce. tests/live_media.sh verifies it through the fence; a flip
# means build, weights or flags changed the output — the sharpest
# regression instrument this stack has. Re-declare on any deliberate
# change, with the report that measured it.
WORKLOAD_SMOKE_SHA256=7f2d3a4397891c51cf06b282c93d282f156f981e91b1c5d58bf75d86d74205b0
WORKLOAD_SMOKE_SHA256_SOURCE=01.09.2026, rep1 sha256 of report 0245 (3 reps identical)
# --- measured fields ------------------------------------------------------
# Born UNMEASURED. Fill both figures or neither, each with date + method,
# plus WORKLOAD_MEASURED_ON — tests/test_workloads.py holds the contract,
# budget.py charges the files plus buffers and says ESTIMATE until then.
#
WORKLOAD_GTT_GIB=23.6
WORKLOAD_GTT_SOURCE=01.09.2026, sideserver workload metering: peak of mem_info_gtt_used at 1 Hz minus the 0.6 GiB settled baseline, production stopped, 3-rep bench (4 steps, 1024x1024); the file estimate had said 23.1 — low again, like sdxl's
WORKLOAD_HOST_RSS_GIB=4.9
WORKLOAD_HOST_RSS_SOURCE=01.09.2026, same run: peak RssAnon summed over the unit cgroup at 1 Hz
WORKLOAD_MEASURED_ON=gfx1151, 124.9 GiB RAM, build vulkan-6b3edaaf3
#
# COST, first bench (bench/reports/2026-09-01_0245_image_flux-schnell/):
# median 56.0 s per 1024x1024 image at 4 steps (min 55.38, max 56.24, n=3)
# — HALF of sdxl's 110-113 s despite the 2.5x larger download, which is
# what a 4-step distillate is for. Deterministic like sdxl: three reps,
# one sha256 (7f2d3a43…). Output visually verified sound 01.09.2026.
