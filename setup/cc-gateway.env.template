# Environment for cc-gateway. The copy lands as ~/.config/cc-gateway.env and
# stays local — it may hold a token and is excluded via .gitignore.
LLAMA_URL=http://127.0.0.1:8080
PORT=8090

# Set to 1 when the model's chat template rejects system messages after
# position 0 (Qwen 3.8 does: 'System message must be at the beginning',
# HTTP 500 for every Claude Code request). Rewrites the volatile counter
# block into a user text block; prefix ids are unaffected. Leave at 0 for
# Laguna. Measured 24.08.2026, see docs/MODELS.md.
#MID_SYSTEM_TO_USER=1

# Thinking mode by MODEL NAME, one loaded model, no extra RAM, no reload:
# llama-server merges request-level chat_template_kwargs over its defaults,
# so the gateway fills them by the model name the consumer sends (/model in
# Claude Code). Kwargs a request already carries always win.
# Measured 25.08. (hard battery): nothink 4/5 @ 21.8s median, low 5/5 @
# 53.6s — low buys correctness for seconds. The 'think' entries carry
# enable_thinking:true explicitly so they override a server-side
# enable_thinking:false default.
#KWARGS_BY_MODEL={"qwen38": {"enable_thinking": false}, "qwen38-think": {"enable_thinking": true, "reasoning_effort": "low"}, "qwen38-deep": {"enable_thinking": true, "reasoning_effort": "medium"}}

# Reachable LOCALLY only. For LAN access add the LAN address here AND set up a
# named access — without a token the gateway rejects everything that does not
# come from 127.0.0.1.
BIND=127.0.0.1
# BIND=127.0.0.1,10.47.43.41
# TOKEN=   (superseded — named access in ~/.config/cc-gateway-tokens)

# MAX_INFLIGHT is asked from the server at start (slot count). Only set it if
# you deliberately want to deviate.
# MAX_INFLIGHT=2

# Seconds without a single byte before aborting. A cold start needs ~100 s, so
# be generous.
SILENCE_MAX=900

# A separate port for tunnel traffic. Everything arriving here counts as
# "remote" and needs a token, regardless of the source IP. Needed because
# behind a tunnel the source IP is cloudflared's, not the client's.
# TUNNEL_PORT=8091
# TUNNEL_BIND=127.0.0.1,172.17.0.1

# File with named access, one consumer per line: name<whitespace>secret
# TOKEN_FILE=~/.config/cc-gateway-tokens

# Concurrent requests per access (default 2)
PER_TOKEN_MAX=2
