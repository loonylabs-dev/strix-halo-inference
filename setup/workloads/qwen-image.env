# --- registry -------------------------------------------------------------
# Read by setup/lib/models.sh (workloads_all) and setup/lib/budget.py
# (workload_plan). Started only through bench/sideserver.py --workload.
WORKLOAD_TITLE=Qwen-Image text-to-image via stable-diffusion.cpp (Vulkan) · Apache 2.0 · 20B-class
WORKLOAD_KIND=image
WORKLOAD_MODE=batch
# The quality end of the current t2i field, Apache 2.0, strongest text
# rendering — and the largest download and slowest expected generation of
# the three image profiles. Components per docs/qwen_image.md of
# stable-diffusion.cpp: diffusion GGUF (QuantStack, Q4_K_M), the Qwen2.5-VL
# 7B text encoder as GGUF Q8_0 (mradermacher), the VAE from QuantStack.
# Fetched 01.09.2026.
#
# Q4_K_M rather than Q8_0 for the 20B diffusion model: 12.2 GiB against
# 20.3. Whether the Q4 tier costs visible quality HERE is unmeasured — the
# LLM Q4-floor finding in docs/MODELS.md is about reasoning models and
# carries no authority over diffusion. If quality disappoints, Q8_0 is one
# download away and this comment is the reminder.
#
# Flags from sd.cpp's own qwen_image example, minus --offload-to-cpu: with
# production stopped this machine holds the ~20 GiB comfortably in GTT, and
# offloading would make the first measurement about the offload path
# instead of the model. --diffusion-fa as in the example — whether flash
# attention is sound on gfx1151/Vulkan is exactly what imagecheck guards.
# --steps 20 pins sd.cpp's default explicitly; --seed 42 fixed.
WORKLOAD_CMD=@HOME@/stable-diffusion.cpp/build-vulkan-6b3edaaf3/bin/sd-cli \
  --diffusion-model @MODELS@/image/Qwen_Image-Q4_K_M.gguf \
  --vae @MODELS@/image/Qwen_Image-VAE.safetensors \
  --llm @MODELS@/image/Qwen2.5-VL-7B-Instruct.Q8_0.gguf \
  -H 1024 -W 1024 --steps 20 --cfg-scale 2.5 --sampling-method euler \
  --diffusion-fa --flow-shift 3 --seed 42 -v
WORKLOAD_PROMPT=a lighthouse on a rocky coast at sunset, detailed oil painting, dramatic clouds
WORKLOAD_FILES=@MODELS@/image/Qwen_Image-Q4_K_M.gguf @MODELS@/image/Qwen_Image-VAE.safetensors @MODELS@/image/Qwen2.5-VL-7B-Instruct.Q8_0.gguf
# WORKLOAD_SOURCE — where the weights come from, machine-readable
# (URLs, space-separated); fetched 01.09.2026. The prose history
# stays in the comments above; this line is for tooling and for
# the next machine.
WORKLOAD_SOURCE=https://huggingface.co/QuantStack/Qwen-Image-GGUF/resolve/main/Qwen_Image-Q4_K_M.gguf https://huggingface.co/QuantStack/Qwen-Image-GGUF/resolve/main/VAE/Qwen_Image-VAE.safetensors https://huggingface.co/mradermacher/Qwen2.5-VL-7B-Instruct-GGUF/resolve/main/Qwen2.5-VL-7B-Instruct.Q8_0.gguf
# WORKLOAD_SMOKE_SHA256 — the DETERMINISM PIN: the exact output hash a
# 1-rep bench at this profile's settings on the pinned build must
# reproduce. tests/live_media.sh verifies it through the fence; a flip
# means build, weights or flags changed the output — the sharpest
# regression instrument this stack has. Re-declare on any deliberate
# change, with the report that measured it.
WORKLOAD_SMOKE_SHA256=454890ddcd1b364e501c129b8754271f8b90d87a9346b0ade9c66cb477fd1a8f
WORKLOAD_SMOKE_SHA256_SOURCE=01.09.2026, rep1 sha256 of report 0249 (3 reps identical)
# --- measured fields ------------------------------------------------------
# Born UNMEASURED. Fill both figures or neither, each with date + method,
# plus WORKLOAD_MEASURED_ON — tests/test_workloads.py holds the contract,
# budget.py charges the files plus buffers and says ESTIMATE until then.
#
WORKLOAD_GTT_GIB=29.7
WORKLOAD_GTT_SOURCE=01.09.2026, sideserver workload metering: peak of mem_info_gtt_used at 1 Hz minus the 0.6 GiB settled baseline, production stopped, 3-rep bench (20 steps, 1024x1024)
WORKLOAD_HOST_RSS_GIB=1.8
WORKLOAD_HOST_RSS_SOURCE=01.09.2026, same run: peak RssAnon summed over the unit cgroup at 1 Hz
WORKLOAD_MEASURED_ON=gfx1151, 124.9 GiB RAM, build vulkan-6b3edaaf3
#
# COST, first bench (bench/reports/2026-09-01_0249_image_qwen-image/):
# median 409.3 s per 1024x1024 image at 20 steps (min 405.11, max 413.27,
# n=3) — ~19 s per sampling step for the 20B-class model, 7.3x sdxl's cost
# and 3.7x flux-schnell's. Deterministic like the other two: three reps,
# one sha256 (454890dd…). Output visually verified sound 01.09.2026,
# --diffusion-fa included — no corruption from flash attention in this
# configuration.
