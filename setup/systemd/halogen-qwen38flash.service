[Unit]
Description=Halogen Flash Server · Qwen3.8-Flash-Next (vLLM-Flash on Strix Halo gfx1151)
After=network-online.target
Wants=network-online.target
# Mutual exclusion: cannot run alongside any llama-user@ model in 128 GB UMA memory.
Conflicts=llama-user@qwen38.service llama-user@gemma26.service \
          llama-user@gemma31.service llama-user@laguna.service \
          llama-user@gptoss.service llama-user@batch.service \
          llama-user@flashnext.service llama-user@qwen36.service \
          llama-user@glm47flash.service halogen-qwen38.service halogen.service
StartLimitIntervalSec=120
StartLimitBurst=3

[Service]
Type=simple
EnvironmentFile=-%h/.config/llm-stack.env
# Fit-to-room (per unit, on ALL halogen units — NEVER in the shared
# llm-stack.env template or on a bench side server, which never runs through a
# unit): an over-budget max_tokens clamps to the window the prompt left instead
# of a 400 the interactive client cannot act on.
Environment=HALOGEN_FIT_TO_ROOM=1
# The BARE checkpoint, not the shipped quality sidecar. With the sidecar the
# model ends agent turns right after announcing a tool call ("…Command selbst:"
# then <|im_end|>): 17 of 50 continuations of five real stalls (123-128k tokens)
# stopped on 0.12.3, 12 of 50 on 0.8.1, 0 of 50 bare — same token prompts,
# 23.09.2026, bench/reports/2026-09-23_colonstop/. Decode speed unchanged in that
# run (~40 vs ~39 tok/s, short continuations only). The price is upstream's
# figure, not ours: ~3.8 % perplexity on prose (#89). halogenexec forwards it.
Environment=HALOGEN_CK_OVERLAY=none
ExecStart=%h/.local/lib/llm-stack/halogenexec qwen38flash
ExecStop=/usr/bin/podman stop -t 10 halogen
ExecStopPost=-/usr/bin/podman rm -f -t 1 halogen
Restart=on-failure
RestartSec=5
TimeoutStartSec=300
TimeoutStopSec=30

[Install]
WantedBy=default.target
