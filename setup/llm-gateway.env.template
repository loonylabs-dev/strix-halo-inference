# Environment for llm-gateway. The copy lands as ~/.config/llm-gateway.env and
# stays local — it may hold a token and is excluded via .gitignore.
LLAMA_URL=http://127.0.0.1:8080
PORT=8090

# Set to 1 when the model's chat template rejects system messages after
# position 0 (Qwen 3.8 does: 'System message must be at the beginning',
# HTTP 500 for every Claude Code request). Rewrites the volatile counter
# block into a user text block; prefix ids are unaffected. Leave at 0 for
# Laguna. Measured 24.08.2026, see docs/MODELS.md.
#MID_SYSTEM_TO_USER=1

# Thinking mode by MODEL NAME, one loaded model, no extra RAM, no reload:
# llama-server merges request-level chat_template_kwargs over its defaults,
# so the gateway fills them by the model name the consumer sends (/model in
# Claude Code). Kwargs a request already carries always win.
# Measured 25.08. (hard battery): nothink 4/5 @ 21.8s median, low 5/5 @
# 53.6s — low buys correctness for seconds. The 'think' entries carry
# enable_thinking:true explicitly so they override a server-side
#KWARGS_BY_MODEL={"local": {"enable_thinking": false}, "local-low": {"enable_thinking": true, "reasoning_effort": "low"}, "local-medium": {"enable_thinking": true, "reasoning_effort": "medium"}, "local-high": {"enable_thinking": true, "reasoning_effort": "high"}}

# Reachable LOCALLY only. For LAN access add the LAN address here AND set up a
# named access — without a token the gateway rejects everything that does not
# come from 127.0.0.1.
BIND=127.0.0.1
# BIND=127.0.0.1,10.47.43.41
# TOKEN=   (superseded — named access in ~/.config/cc-gateway-tokens)

# MAX_INFLIGHT is asked from the server at start (slot count). On single-GPU/UMA
# systems with speculative decoding (Halogen / MTP), set MAX_INFLIGHT=1 to
# serialise execution on the GPU (~45-50 t/s) while preserving multi-session KV slots.
# MAX_INFLIGHT=1

# CLAMP_DEEP_PROMPT_CHARS + CLAMP_MAX_TOKENS — a clamp for the edge case only,
# and almost certainly NOT for you. Both default to 0, which is off, and either
# one at 0 disables the pair.
#
# What it is for. A Halogen KV reservation is prompt PLUS max_tokens, reserved
# whether or not it is used. Measured 21.09.2026 on this machine against a
# 524288-position pool (bench/reports/2026-09-21_1630_halogen-0.8.1-vs-0.12.3):
#
#   two deep sessions at 193k-230k prompt tokens, 32000 output each
#     -> 86% to 99.9% of the pool. IT FITS. Nothing should be clamped.
#   the same two at 230k plus a THIRD session, even a small one
#     -> 110%: every turn re-prefills its whole prompt, p50 184 s against
#        0.95 s, cache hit rate 0.0, and on 0.12.3 the server names it
#        ("kv pool: no room for N positions; forgot the region at A").
#
# So a main session with one subagent — the normal shape here — needs no clamp
# at all, and 16-32k of output is fine. This exists for the operator who knows
# a third deep session is coming and would rather have a shorter answer than a
# re-prefill.
#
# WHY THE GATE IS THE PROMPT, IN CHARACTERS. The first version of this clamped
# on max_tokens alone and was switched off within the hour: a regular request
# asking for 32k of output on a SHALLOW prompt reserves 34k of the pool, which
# is harmless, and clamping it would cut a real answer to buy room that was
# never short. Characters rather than estimated tokens because a
# chars-per-token constant is not a property of this gateway — synthetic
# records run about 2.1, prose and code nearer 3.5-4, and a threshold that
# silently means something different per content type is worse than none.
# Image payloads are not counted (a base64 blob is huge in characters and about
# a thousand tokens).
#
# Each clamp writes a CLAMP line naming the prompt size, and puts
# max_tokens_clamped_from into the request so the trace carries it: a shortened
# answer is never silent. A silent clamp cost this project a benchmark run once
# — 16,384 asked, 4,096 returned, no error — and `finish_reason: length` reads
# the same whether the model stopped or the server truncated.
#
# Raising HALOGEN_KV_POOL_POSITIONS instead is the wrong direction: 786432 left
# 5.6 GiB of host RAM and produced six watchdog shutdowns (setup/defects.json:
# halogen-pagecache-starvation-watchdog-kill).
# CLAMP_DEEP_PROMPT_CHARS=600000
# CLAMP_MAX_TOKENS=8000

# Seconds without a single byte before aborting. A cold start needs ~100 s, so
# be generous.
SILENCE_MAX=900

# How often (seconds) to send keepalive pings/comments while a request is queued.
# Default 10s prevents client read timeouts (such as DeepSeek Harness 40s timeout).
# QUEUE_KEEPALIVE=10

# Inactivity timeout (seconds) for the CPU vision sidecar before auto-stopping (default 600s / 10 min).
# Set to 0 to keep llama-vision running indefinitely.
# VISION_IDLE_TIMEOUT=600

# A separate port for tunnel traffic. Everything arriving here counts as
# "remote" and needs a token, regardless of the source IP. Needed because
# behind a tunnel the source IP is cloudflared's, not the client's.
# TUNNEL_PORT=8091
# TUNNEL_BIND=127.0.0.1,172.17.0.1

# File with named access, one consumer per line: name<whitespace>secret
# TOKEN_FILE=~/.config/llm-gateway-tokens

# Concurrent requests per access (default 2)
PER_TOKEN_MAX=2

# Maximum disk usage for trace logs (default 2 GB). Also adjustable live via
# `python3 tools/tracelog.py cap 2gb`.
# TRACE_CAP_BYTES=2147483648

