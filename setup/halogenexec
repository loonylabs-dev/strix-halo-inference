#!/usr/bin/env bash
# halogenexec — launch Halogen Flash Server container via rootless podman.
#
# Executed by setup/systemd/halogen-qwen38flash.service, halogen-qwen38.service, or halogen.service.
# Halogen Flash Server (vLLM-Flash) provides high-performance inference on
# AMD Strix Halo (gfx1151) with radix KV caching and OpenAI API compatible endpoints.
set -euo pipefail

# The repo, resolved through the symlink install.sh puts in ~/.local/lib.
REPO="$(cd "$(dirname "$(realpath "${BASH_SOURCE[0]}")")/.." && pwd)"
# shellcheck source=lib/models.sh
. "$REPO/setup/lib/models.sh"

FLAVOR="${1:-${HALOGEN_FLAVOR:-qwen38flash}}"
case "$FLAVOR" in
  qwen38|halogen-qwen38|27b)
    FLAVOR="qwen38"
    ;;
  *)
    FLAVOR="qwen38flash"
    ;;
esac

# 1. Model directory and image — ASKED, not resolved here. Three files used to
#    carry a copy of this fallback chain and two spelled the image tag out;
#    see setup/lib/models.sh for what that costs on a version bump.
MODELS_DIR="$(halogen_models_dir)"

if [ -z "$MODELS_DIR" ] || [ ! -d "$MODELS_DIR" ]; then
  echo "halogenexec: no halogen-models directory found." >&2
  echo "  Run bash setup/scripts/fetch-halogen.sh or set HALOGEN_MODELS in ~/.config/llm-stack.env" >&2
  exit 1
fi

if [ "$FLAVOR" = "qwen38" ]; then
  CHECKPOINT_FILE="${HALOGEN_CHECKPOINT_FILE:-$(find -L "$MODELS_DIR" -maxdepth 1 -name 'qwen3.8-27b*.hgn' 2>/dev/null | head -1)}"
  CHECKPOINT_FILE="${CHECKPOINT_FILE:-$MODELS_DIR/qwen3.8-27b-p1w4d-d2.hgn}"
  if [ ! -f "$CHECKPOINT_FILE" ]; then
    echo "halogenexec: Qwen3.8-27B checkpoint file not found at $CHECKPOINT_FILE" >&2
    exit 1
  fi
else
  CHECKPOINT_FILE="${HALOGEN_CHECKPOINT_FILE:-$MODELS_DIR/qwen38-flash-next-w4b.hgn}"
  if [ ! -f "$CHECKPOINT_FILE" ]; then
    echo "halogenexec: checkpoint file not found at $CHECKPOINT_FILE" >&2
    echo "  Run bash setup/scripts/fetch-halogen.sh" >&2
    exit 1
  fi
fi

# Clean up any previously dead or lingering container
podman rm -f halogen >/dev/null 2>&1 || true

HOST_PORT="${HALOGEN_HOST_PORT:-8080}"
CONTAINER_PORT=8731
IMAGE="$(halogen_image "$FLAVOR")"

# The sha256 of /halogen/tools/serve_api.py in the image the vendored copy
# was cut from. Written in its header too; compared by tests/test_halogen.py
# so they cannot drift apart.
#
# tool_parse.py was vendored too until 21.09.2026 and is NOT any more. Its
# only change had been the vendoring header — the incremental tool-call
# parameter streaming it once carried was adopted upstream in 0.6.1 — so the
# mount froze a file it did not patch. What that cost was measured when this
# image was cut: 0.10.2 added the merge of several leading system messages to
# that file (public issue #60, what older opencode builds send), and the
# stale copy would have reverted it. One vendored file is one retirement
# condition to check per bump; this is the other one retired.
BASE_SHA256="97019cc97cdad6f21f0abe795527de740422f94b81324ffee27f237dd1dcc572"

EXTRA_MOUNTS=()
PATCHED="$REPO/setup/halogen/serve_api.py"
if [ -f "$PATCHED" ]; then
  # VERIFY BEFORE OVERRIDING. The mount replaces a file inside a pinned
  # image, and the failure it invites is silent in the worst direction: bump
  # the tag and `podman ps` reports the new version while this old copy
  # reverts every upstream change to that one file. So the base is hashed and
  # compared, and a mismatch REFUSES rather than warns — a start that quietly
  # served a half-reverted front-end is the outcome being prevented.
  #
  # Costs one podman create + cp of 150 KB files against an already-present
  # image: measured well under a second, against an engine that needs twelve.
  vc="halogen-verify-$$"
  tmp="$(mktemp -t halogen-base-XXXXXX.py)"
  base_sha=""
  if podman create --name "$vc" "$IMAGE" true >/dev/null 2>&1; then
    podman cp "$vc:/halogen/tools/serve_api.py" "$tmp" >/dev/null 2>&1 \
      && base_sha="$(sha256sum "$tmp" | cut -d' ' -f1)"
    podman rm -f "$vc" >/dev/null 2>&1 || true
  fi
  rm -f "$tmp"

  if [ -z "$base_sha" ]; then
    echo "halogenexec: could not read /halogen/tools/serve_api.py out of $IMAGE." >&2
    echo "  The patched copy in setup/halogen/ cannot be verified, and mounting" >&2
    echo "  an unverified override is the thing this check exists to prevent." >&2
    exit 1
  fi
  if [ "$base_sha" != "$BASE_SHA256" ]; then
    echo "halogenexec: $IMAGE no longer carries the file the patched copy was cut from." >&2
    echo "  expected $BASE_SHA256" >&2
    echo "  found    $base_sha" >&2
    echo "  Re-cut the copy and re-apply the hunks its header describes:" >&2
    echo "    podman create --name halogen-cut $IMAGE true" >&2
    echo "    podman cp halogen-cut:/halogen/tools/serve_api.py /tmp/serve_api.new.py" >&2
    echo "    podman rm -f halogen-cut" >&2
    echo "    diff -u /tmp/serve_api.new.py setup/halogen/serve_api.py" >&2
    exit 1
  fi
  EXTRA_MOUNTS+=(-v "$PATCHED:/halogen/tools/serve_api.py:ro")
fi

SLOTS_WANT="${HALOGEN_KV_SLOTS:-$(local_var HALOGEN_KV_SLOTS)}"
SLOTS_WANT="${SLOTS_WANT:-4}"
VISION_ARGS=()
VISION_WANT="${HALOGEN_VISION_TOWER:-$(local_var HALOGEN_VISION_TOWER 2>/dev/null || true)}"
if [ -z "$VISION_WANT" ] && [ -f "$MODELS_DIR/qwen38-flash-next-vision.hgn" ]; then
  VISION_WANT=1
fi
if [ -n "$VISION_WANT" ]; then
  VISION_ARGS+=(-e HALOGEN_VISION_TOWER="$VISION_WANT")
fi

POOL_WANT="${HALOGEN_KV_POOL_POSITIONS:-$(local_var HALOGEN_KV_POOL_POSITIONS 2>/dev/null || true)}"
POOL_WANT="${POOL_WANT:-786432}"

MAX_TOK_WANT="${HALOGEN_MAX_TOK:-$(local_var HALOGEN_MAX_TOK 2>/dev/null || true)}"
MAX_TOK_WANT="${MAX_TOK_WANT:-16384}"

EXTRA_ENV=()
# An allowlist: a variable not named here never reaches the container, however
# it is set. HALOGEN_CACHE_BRANCHES (0.13.3) and HALOGEN_EOS_GUARD (0.13.4) were
# added with the 0.13.4 bump, 22.09.2026; unset they take upstream's defaults
# (2, and on). 0.13.5-0.13.8 read no new name (24.09.2026).
for var in HALOGEN_TEMPERATURE HALOGEN_TOP_P HALOGEN_TOP_K HALOGEN_MIN_P \
           HALOGEN_MAX_THINKING_TOKENS HALOGEN_MAX_TOKENS_DEFAULT \
           HALOGEN_MAX_TOKENS_CAP HALOGEN_REASONING_EFFORT HALOGEN_CACHE_ENTRIES \
           HALOGEN_CACHE_BRANCHES HALOGEN_EOS_GUARD \
           HALOGEN_FIT_TO_ROOM HALOGEN_FIT_TO_ROOM_FLOOR \
           HALOGEN_CK_OVERLAY; do
  val="${!var:-$(local_var "$var" 2>/dev/null || true)}"
  if [ -n "$val" ]; then
    EXTRA_ENV+=(-e "$var=$val")
  fi
done

if [ "$FLAVOR" = "qwen38" ]; then
  SLOTS_WANT="${HALOGEN_KV_SLOTS:-$(local_var HALOGEN_KV_SLOTS)}"
  SLOTS_WANT="${SLOTS_WANT:-1}"
  SLOT_CTX="${HALOGEN_SLOT_CTX:-$(local_var HALOGEN_SLOT_CTX)}"
  SLOT_CTX="${SLOT_CTX:-262144}"
  DRAFTER_WANT="${HALOGEN_DRAFTER:-2}"

  echo "halogenexec: starting Halogen Server (Qwen3.8-27B) from $MODELS_DIR on port $HOST_PORT (slots: $SLOTS_WANT, slot_ctx: $SLOT_CTX, drafter: $DRAFTER_WANT)..."
  exec podman run --rm \
    --name halogen \
    --device /dev/kfd \
    --device /dev/dri \
    --security-opt label=disable \
    -v "$MODELS_DIR":/models:ro \
    --net=host \
    -e HALOGEN_API_PORT="$HOST_PORT" \
    -e HALOGEN_KV_SLOTS="$SLOTS_WANT" \
    -e HALOGEN_SLOT_CTX="$SLOT_CTX" \
    -e HALOGEN_DRAFTER="$DRAFTER_WANT" \
    -e HALOGEN_CHECKPOINT="/models/$(basename "$CHECKPOINT_FILE")" \
    "${EXTRA_ENV[@]}" \
    "$IMAGE"
fi

echo "halogenexec: starting Halogen Flash Server (Qwen3.8-Flash-Next) from $MODELS_DIR on port $HOST_PORT (slots: $SLOTS_WANT, pool: $POOL_WANT, max_tok: $MAX_TOK_WANT)..."
exec podman run --rm \
  --name halogen \
  --device /dev/kfd \
  --device /dev/dri \
  --security-opt label=disable \
  -v "$MODELS_DIR":/models:ro \
  "${EXTRA_MOUNTS[@]}" \
  --net=host \
  -e HALOGEN_API_PORT="$HOST_PORT" \
  -e HALOGEN_KV_SLOTS="$SLOTS_WANT" \
  -e HALOGEN_KV_POOL_POSITIONS="$POOL_WANT" \
  -e HALOGEN_MAX_TOK="$MAX_TOK_WANT" \
  -e HALOGEN_CHECKPOINT=/models/qwen38-flash-next-w4b.hgn \
  -e HALOGEN_ADMIT_CHUNK="${HALOGEN_ADMIT_CHUNK:--1}" \
  "${VISION_ARGS[@]}" \
  "${EXTRA_ENV[@]}" \
  "$IMAGE" all
