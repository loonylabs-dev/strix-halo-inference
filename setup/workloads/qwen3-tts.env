# --- registry -------------------------------------------------------------
# Read by setup/lib/models.sh (workloads_all) and setup/lib/budget.py
# (workload_plan). Started only through bench/sideserver.py --workload.
WORKLOAD_TITLE=Qwen3-TTS 1.7B CustomVoice text-to-speech via qwentts.cpp (Vulkan) · Apache 2.0
WORKLOAD_KIND=audio
WORKLOAD_MODE=batch
# Why this model: the 2026 pick for the ggml side of the border. Qwen3-TTS
# went open (Apache 2.0) in January 2026; 10 languages INCLUDING GERMAN,
# named speakers, and a dedicated GGML port (qwentts.cpp) with a Vulkan
# backend — the sd.cpp pattern exactly, no Python anywhere. Chosen over
# Kokoro (German only via community forks) and over torch-first stacks;
# the torch-lane quality pick is chatterbox.env beside this.
#
# qwen-tts reads text from STDIN; the workload contract appends -p/-o, so
# the CMD names the ADAPTER (qwen-tts-p) that build-qwentts.sh writes
# beside the binary. Build PINNED, no symlink — the flashnext discipline.
#
# --seed 42 pinned: the upstream default is -1, A RANDOM SEED PER RUN —
# unpinned, two runs are two experiments. Whether a fixed seed actually
# yields byte-identical WAVs here is recorded by audiobench as an
# observation (distinct_outputs), not assumed. --speaker serena: one of
# the nine CustomVoice speakers; no German-specific voice exists, the
# speakers are multilingual. --lang German per the CLI's label form.
WORKLOAD_CMD=@HOME@/qwentts.cpp/build-vulkan-a8a7716b5/qwen-tts-p \
  --model @MODELS@/audio/qwen-talker-1.7b-customvoice-Q8_0.gguf \
  --codec @MODELS@/audio/qwen-tokenizer-12hz-Q8_0.gguf \
  --speaker serena --lang German --seed 42
WORKLOAD_PROMPT=Es war einmal ein alter Leuchtturm an einer felsigen Küste, der jede Nacht sein warmes Licht über das dunkle Meer schickte.
# Q8_0 as the repo's recommended default; fetched 01.09.2026 from
# Serveurperso/Qwen3-TTS-GGUF (talker 2.0 GB + codec 0.3 GB).
WORKLOAD_FILES=@MODELS@/audio/qwen-talker-1.7b-customvoice-Q8_0.gguf @MODELS@/audio/qwen-tokenizer-12hz-Q8_0.gguf
# WORKLOAD_SOURCE — where the weights come from, machine-readable
# (URLs, space-separated); fetched 01.09.2026. The prose history
# stays in the comments above; this line is for tooling and for
# the next machine.
WORKLOAD_SOURCE=https://huggingface.co/Serveurperso/Qwen3-TTS-GGUF/resolve/main/qwen-talker-1.7b-customvoice-Q8_0.gguf https://huggingface.co/Serveurperso/Qwen3-TTS-GGUF/resolve/main/qwen-tokenizer-12hz-Q8_0.gguf
# WORKLOAD_SMOKE_SHA256 — the DETERMINISM PIN: the exact output hash a
# 1-rep bench at this profile's settings on the pinned build must
# reproduce. tests/live_media.sh verifies it through the fence; a flip
# means build, weights or flags changed the output — the sharpest
# regression instrument this stack has. Re-declare on any deliberate
# change, with the report that measured it.
WORKLOAD_SMOKE_SHA256=c7778614ee5d4c35209ebbec6a4928620b4cc19e86e9eb947f9693f81ec23d84
WORKLOAD_SMOKE_SHA256_SOURCE=01.09.2026, rep1 sha256 of reports 0527/1023 (6 reps across the worklib refactor identical)
# --- measured fields ------------------------------------------------------
# Born UNMEASURED. Fill both figures or neither, each with date + method,
# plus WORKLOAD_MEASURED_ON — tests/test_workloads.py holds the contract.
#
WORKLOAD_GTT_GIB=3.6
WORKLOAD_GTT_SOURCE=01.09.2026, sideserver workload metering: peak of mem_info_gtt_used at 1 Hz minus the 0.7 GiB settled baseline, production stopped, 3-rep bench (German sentence, speaker serena)
WORKLOAD_HOST_RSS_GIB=0.1
WORKLOAD_HOST_RSS_SOURCE=01.09.2026, same run: peak RssAnon summed over the unit cgroup at 1 Hz
WORKLOAD_MEASURED_ON=gfx1151, 124.9 GiB RAM, build vulkan-a8a7716b5
#
# COST, first bench (bench/reports/2026-09-01_0527_audio_qwen3-tts/):
# median 3.75 s wall for 9.92 s of 24 kHz German audio — REALTIME FACTOR
# 2.65 (min wall 3.74, max 4.14 incl. model load per invocation, n=3).
# Byte-deterministic at --seed 42: three reps, one sha256 (c7778614…),
# distinct_outputs=1 — same instrument class as the image workloads.
# At +3.6 GiB of GTT this is small enough to consider CO-RESIDENT beside
# qwen38 (38.1 + 3.6*1.1 + margins fit the arithmetic) — that would be the
# first two-tenant experiment, deliberately NOT run tonight.
