[Unit]
Description=Clean up saved prefixes (by least recently used)

[Service]
Type=oneshot
# The size limit comes from the GATEWAY's env file, not from a number typed
# here. Two limits govern this store and they have to be the same one: the
# gateway STOPS SAVING at AUTO_MAX_GB, this timer PRUNES DOWN TO it. A pruning
# limit below the saving limit means the two fight over every prefix; above it,
# the timer never fires at all. Both were `20` and agreed by coincidence.
#
# /bin/sh because systemd expands ${VAR} but has no ${VAR:-default}, and a
# missing variable would make this `--max-gb ` with nothing after it — argparse
# would refuse, and a cleanup that refuses is a store that grows silently.
#
# Size limit as the main rule, TTL against leftovers after configuration
# changes. What goes first is always the longest UNUSED — the file date is no
# good, because a prefix never changes through use.
EnvironmentFile=-%h/.config/cc-gateway.env
# AUTO_MAX_GB=0 is a legitimate setting: cc-gateway reads it as "the store may
# use no disk" and stops saving. prewarm REFUSES a limit of 0 — deliberately,
# because in a deleting tool 0 is ambiguous — so the two would have disagreed
# on the one value that is easiest to type. Translated here instead: no disk
# means keep nothing.
ExecStart=/bin/sh -c 'L="${AUTO_MAX_GB:-20}"; if [ "$L" = "0" ]; then exec /usr/bin/python3 %h/.claude/bin/prewarm.py cleanup --purge; else exec /usr/bin/python3 %h/.claude/bin/prewarm.py cleanup --max-gb "$L" --ttl-days 28; fi'
