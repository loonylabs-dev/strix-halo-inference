# What belongs to THIS MACHINE rather than to the repo.
#
# install.sh copies this to ~/.config/llm-stack.env and fills in what it can
# derive. The copy stays local and is excluded via .gitignore — it names your
# directories and possibly your hostname, and neither belongs in a repository
# that other people clone.
#
# systemd EnvironmentFile syntax, like every other .env here, so the units can
# load it directly (`EnvironmentFile=-`) and setup/lib/systemdfile.py can read
# it. NOT bash-sourceable: `. file.env` makes bash read `VAR=value command
# args`. Use `python3 setup/lib/systemdfile.py local <NAME>` or the shell
# helper `local_var` in setup/lib/models.sh.
#
# Why this file exists at all: until 27.08.2026 these answers were DEFAULTS in
# the code — `/mnt/shared/LLM` in eighteen files, a private hostname in
# smoketest.sh. A default that exists on one computer is not a default. The
# worst of them had a consequence: a stranger who cloned the repo and ran the
# smoke test sent requests to somebody else's tunnel.

# Where the .gguf files live. install.sh looks for a directory that actually
# holds some; setup/lib/systemdfile.py also accepts $LLAMA_MODELS for a single
# command, and falls back to the conventional locations (~/models,
# ~/.cache/llama.cpp, ~/.local/share/models, ./models) when nothing is set.
LLAMA_MODELS=

# The public hostname of the Cloudflare tunnel, if there is one. NO DEFAULT on
# purpose — a hostname cannot be derived, and guessing one means aiming a test
# at a machine that is not yours. Leave it empty if you serve only locally;
# `bash setup/smoketest.sh --local-only` then skips the zones that need it.
GATEWAY_HOST=

# Where llama.cpp is built. The build directory itself is chosen by
# setup/scripts/build-llama.sh, which keeps a stable symlink per backend;
# this is only the parent.
LLAMA_CPP=

# A shortcut that points at the repo docs, checked by setup/check.sh.
# Empty means the section says nothing.
DOCS_LINK=
