# --- registry -------------------------------------------------------------
# Read by setup/lib/models.sh (workloads_all) and setup/lib/budget.py
# (workload_plan). Started only through bench/sideserver.py --workload.
WORKLOAD_TITLE=Wan2.2 TI2V 5B text-to-video via stable-diffusion.cpp (Vulkan) · Apache 2.0 · Q8_0
WORKLOAD_KIND=video
WORKLOAD_MODE=batch
# The quality step above wan21-t2v.env: same family, same Apache 2.0, same
# umt5-xxl text encoder — different diffusion checkpoint (5B, Q8_0 GGUF)
# and its OWN VAE (wan2.2_vae; the 2.1 VAE fits every Wan model EXCEPT
# this one — sd.cpp's docs, worth repeating because the mismatch would be
# a silent garbage generator, exactly what videocheck exists for).
#
# Flags from sd.cpp's wan.md TI2V-5B example, minus --offload-to-cpu (with
# production fenced off this machine holds the ~12 GiB in GTT; offloading
# would make the first measurement about the offload path). Portrait
# 480x832 as in the example. --steps 20 pins the default, --seed 42 fixed.
# -o appended by the runner; -n spaceless for the whitespace-split parser.
WORKLOAD_CMD=@HOME@/stable-diffusion.cpp/build-vulkan-6b3edaaf3/bin/sd-cli \
  -M vid_gen \
  --diffusion-model @MODELS@/video/Wan2.2-TI2V-5B-Q8_0.gguf \
  --vae @MODELS@/video/wan2.2_vae.safetensors \
  --t5xxl @MODELS@/video/umt5-xxl-encoder-Q8_0.gguf \
  -W 480 -H 832 --video-frames 33 --steps 20 \
  --cfg-scale 6.0 --sampling-method euler --flow-shift 3.0 \
  --diffusion-fa --seed 42 -v \
  -n 色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走
WORKLOAD_PROMPT=a lighthouse on a rocky coast at sunset, waves crashing against the rocks, dramatic clouds drifting, cinematic
# Fetched 01.09.2026: diffusion Q8_0 from QuantStack/Wan2.2-TI2V-5B-GGUF,
# VAE from Comfy-Org/Wan_2.2_ComfyUI_Repackaged, encoder shared with
# wan21-t2v.env (city96).
WORKLOAD_FILES=@MODELS@/video/Wan2.2-TI2V-5B-Q8_0.gguf @MODELS@/video/wan2.2_vae.safetensors @MODELS@/video/umt5-xxl-encoder-Q8_0.gguf
# WORKLOAD_SOURCE — where the weights come from, machine-readable
# (URLs, space-separated); fetched 01.09.2026. The prose history
# stays in the comments above; this line is for tooling and for
# the next machine.
WORKLOAD_SOURCE=https://huggingface.co/QuantStack/Wan2.2-TI2V-5B-GGUF/resolve/main/Wan2.2-TI2V-5B-Q8_0.gguf https://huggingface.co/Comfy-Org/Wan_2.2_ComfyUI_Repackaged/resolve/main/split_files/vae/wan2.2_vae.safetensors https://huggingface.co/city96/umt5-xxl-encoder-gguf/resolve/main/umt5-xxl-encoder-Q8_0.gguf
# WORKLOAD_SMOKE_SHA256 — the DETERMINISM PIN: the exact output hash a
# 1-rep bench at this profile's settings on the pinned build must
# reproduce. tests/live_media.sh verifies it through the fence; a flip
# means build, weights or flags changed the output — the sharpest
# regression instrument this stack has. Re-declare on any deliberate
# change, with the report that measured it.
WORKLOAD_SMOKE_SHA256=23780e83df1029639691e997782ce24307af48859a70447603ab4d65843398cb
WORKLOAD_SMOKE_SHA256_SOURCE=01.09.2026, rep1 SEQUENCE hash of report 0925 (3 reps identical) — PINS THE MESH ARTIFACT deliberately: if the fp16 isolation experiment changes the output, this hash flips and gets re-declared, which is exactly the announcement wanted
# --- measured fields ------------------------------------------------------
# Born UNMEASURED. Fill both figures or neither, each with date + method,
# plus WORKLOAD_MEASURED_ON — tests/test_workloads.py holds the contract.
#
WORKLOAD_GTT_GIB=27.1
WORKLOAD_GTT_SOURCE=01.09.2026, sideserver workload metering: peak of mem_info_gtt_used at 1 Hz minus the 0.7 GiB settled baseline, production stopped, 3-rep bench (33 frames, 480x832, 20 steps)
WORKLOAD_HOST_RSS_GIB=1.2
WORKLOAD_HOST_RSS_SOURCE=01.09.2026, same run: peak RssAnon summed over the unit cgroup at 1 Hz
WORKLOAD_MEASURED_ON=gfx1151, 124.9 GiB RAM, build vulkan-6b3edaaf3
#
# COST, first bench (bench/reports/2026-09-01_0925_video_wan22-ti2v/):
# median 288 s per 33-frame clip at 480x832/20 steps — HALF of wan21's 536
# despite 4x the parameters, because the Wan-2.2 VAE compresses the latent
# harder. More motion too (mean frame diff 2.47 vs 0.31). Deterministic at
# seed 42 (one sequence hash per config).
#
# OPEN — USE WITH EYES OPEN: the lower (dark) half of every frame carries
# a regular mesh/scale artifact, seen by eye 01.09.2026 and INVISIBLE to
# videocheck (it is locally structured, neither solid nor noise). One
# one-variable A/B is on record: WITHOUT --diffusion-fa the artifact is
# unchanged (report ..._0940_video_wan22-nofa vs ..._0925), so flash
# attention is exonerated. Remaining suspects, unisolated: the Q8_0 quant
# (fp16 is a 10 GB download away — the next experiment), the wan2.2 VAE
# decode in dark low-signal regions, or the model at these settings. The
# 1.3B profile with the 2.1 VAE shows nothing comparable. Until isolated,
# wan21-t2v.env is the trustworthy video profile.
