# --- registry -------------------------------------------------------------
# Read by setup/lib/models.sh (workloads_all) and setup/lib/budget.py
# (workload_plan). Started only through bench/sideserver.py --workload.
WORKLOAD_TITLE=Wan2.1 T2V 1.3B text-to-video via stable-diffusion.cpp (Vulkan) · Apache 2.0 · 480p
WORKLOAD_KIND=video
WORKLOAD_MODE=batch
# Why this model first: the smallest established open text-to-video model
# (Apache 2.0, the community standard family), on the same sd.cpp build
# the image profiles already measured — no new tree, no Torch. The quality
# step up is wan22-ti2v.env (5B, 720p-capable) beside this; the day either
# disappoints, HunyuanVideo is NOT the fallback (its licence excludes EU
# territory) and LTX-2.x carries a 12B Gemma text encoder — both noted so
# the next reader does not rediscover this.
#
# Flags from sd.cpp's own wan.md example, with two changes: --steps 20
# pins the default explicitly, --seed 42 fixed (two runs, one experiment).
# -o is appended by the runner: a printf-style frame pattern from
# videobench (frames are the evidence), a .webm from the sideserver smoke.
# The -n negative prompt is Wan's standard Chinese one, written WITHOUT
# spaces because WORKLOAD_CMD splits on whitespace — systemd
# EnvironmentFile syntax, no shell quoting.
WORKLOAD_CMD=@HOME@/stable-diffusion.cpp/build-vulkan-6b3edaaf3/bin/sd-cli \
  -M vid_gen \
  --diffusion-model @MODELS@/video/wan2.1_t2v_1.3B_fp16.safetensors \
  --vae @MODELS@/video/wan_2.1_vae.safetensors \
  --t5xxl @MODELS@/video/umt5-xxl-encoder-Q8_0.gguf \
  -W 832 -H 480 --video-frames 33 --steps 20 \
  --cfg-scale 6.0 --sampling-method euler --flow-shift 3.0 \
  --diffusion-fa --seed 42 -v \
  -n 色调艳丽，过曝，静态，细节模糊不清，字幕，风格，作品，画作，画面，静止，整体发灰，最差质量，低质量，JPEG压缩残留，丑陋的，残缺的，多余的手指，画得不好的手部，画得不好的脸部，畸形的，毁容的，形态畸形的肢体，手指融合，静止不动的画面，杂乱的背景，三条腿，背景人很多，倒着走
WORKLOAD_PROMPT=a lighthouse on a rocky coast at sunset, waves crashing against the rocks, dramatic clouds drifting, cinematic
# Fetched 01.09.2026: diffusion fp16 from Comfy-Org/Wan_2.1_ComfyUI_repackaged,
# VAE from the same repo, umt5-xxl encoder Q8_0 from city96.
WORKLOAD_FILES=@MODELS@/video/wan2.1_t2v_1.3B_fp16.safetensors @MODELS@/video/wan_2.1_vae.safetensors @MODELS@/video/umt5-xxl-encoder-Q8_0.gguf
# WORKLOAD_SOURCE — where the weights come from, machine-readable
# (URLs, space-separated); fetched 01.09.2026. The prose history
# stays in the comments above; this line is for tooling and for
# the next machine.
WORKLOAD_SOURCE=https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_repackaged/resolve/main/split_files/diffusion_models/wan2.1_t2v_1.3B_fp16.safetensors https://huggingface.co/Comfy-Org/Wan_2.1_ComfyUI_repackaged/resolve/main/split_files/vae/wan_2.1_vae.safetensors https://huggingface.co/city96/umt5-xxl-encoder-gguf/resolve/main/umt5-xxl-encoder-Q8_0.gguf
# WORKLOAD_SMOKE_SHA256 — the DETERMINISM PIN: the exact output hash a
# 1-rep bench at this profile's settings on the pinned build must
# reproduce. tests/live_media.sh verifies it through the fence; a flip
# means build, weights or flags changed the output — the sharpest
# regression instrument this stack has. Re-declare on any deliberate
# change, with the report that measured it.
WORKLOAD_SMOKE_SHA256=170973770f0754cac50d78c1dcbb97bfc23d3ed9ace624d2daff259741c71d26
WORKLOAD_SMOKE_SHA256_SOURCE=01.09.2026, rep1 SEQUENCE hash (sha256 over frame sha256s) of report 0857 (3 reps identical)
# --- measured fields ------------------------------------------------------
# Born UNMEASURED. Fill both figures or neither, each with date + method,
# plus WORKLOAD_MEASURED_ON — tests/test_workloads.py holds the contract.
# NOTE sd.cpp's own docs warn the Wan VAE decode is the memory spike; the
# first metered run decides whether 33 frames at 480p fit without --vae-tiling.
#
WORKLOAD_GTT_GIB=22.2
WORKLOAD_GTT_SOURCE=01.09.2026, sideserver workload metering: peak of mem_info_gtt_used at 1 Hz minus the 0.6 GiB settled baseline, production stopped, 3-rep bench (33 frames, 832x480, 20 steps). The file estimate said 14.5 — the docs' warning about the Wan VAE decode spike, measured: +7.7 GiB over it
WORKLOAD_HOST_RSS_GIB=5.9
WORKLOAD_HOST_RSS_SOURCE=01.09.2026, same run: peak RssAnon summed over the unit cgroup at 1 Hz
WORKLOAD_MEASURED_ON=gfx1151, 124.9 GiB RAM, build vulkan-6b3edaaf3
#
# COST, first bench (bench/reports/2026-09-01_0857_video_wan21-t2v/):
# median 536 s per clip of 33 frames at 832x480/20 steps — 16.2 s per
# frame, i.e. a 2.1 s clip @16 fps costs ~9 minutes. Byte-deterministic at
# seed 42: three reps, one sequence hash (17097377…). Output verified by
# eye 01.09.2026: coherent lighthouse scene, SUBTLE motion (mean frame
# diff 0.31 — well above the frozen line at 0.05, but a sedate scene; the
# 1.3B temperament, not a defect). Quality beyond broken/not-broken is
# deliberately not judged here.
